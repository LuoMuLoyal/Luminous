* text=auto

*.bat text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf

*.dart text eol=lf
*.java text eol=lf
*.kt text eol=lf
*.kts text eol=lf
*.ts text eol=lf
*.js text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# Tracked generated Dart sources stay committed because flutter pub get does
# not run build_runner and the app depends on a checked-in local OpenAPI
# package.
*.g.dart linguist-generated
*.freezed.dart linguist-generated
lib/l10n/app_localizations*.dart linguist-generated
packages/lucent_openapi/** linguist-generated

# Generated OpenAPI client may contain trailing spaces in comments/docs.
# Ignore those whitespace-only warnings in git diff --check for this path.
packages/lucent_openapi/** whitespace=-blank-at-eol,-blank-at-eof

*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.pdf binary
*.xlsx binary
*.tar binary
*.jar binary
*.jks binary
*.keystore binary
