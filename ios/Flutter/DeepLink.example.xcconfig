// Copy this file to DeepLink.xcconfig and fill the real value locally or in CI.
// DEEP_LINK_HOST must match the host used by the server-side
// /.well-known/apple-app-site-association file, and must equal the Dart-side
// LUMINOUS_DEEP_LINK_HOST so `isAcceptedDeepLink` accepts the callback.
// When unset, iOS falls back to the `luminous://` custom scheme registered in
// Info.plist (associated domains simply will not verify).
DEEP_LINK_HOST = luminous.invalid
