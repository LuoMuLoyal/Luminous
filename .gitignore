# Flutter/Dart/Pub related
# Generated sources are local-only. Track generator inputs/config, not outputs.
**/doc/api/
**/ios/Flutter/.last_build_id
**/ios/Flutter/Wechat.xcconfig
.dart_tool/
.flutter
.flutter_tool_state
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/
lib/l10n/app_localizations.dart
lib/l10n/app_localizations_*.dart
# Merged ARB — generated from lib/l10n/src/ by `dart scripts/arb_tools.dart merge`
lib/l10n/app_zh.arb
lib/l10n/app_en.arb
**/*.freezed.dart
**/*.g.dart
**/*.drift.dart
# Drift web worker — compiled from web/drift_worker.dart
web/drift_worker.js
web/drift_worker.js.deps
web/drift_worker.js.map
packages/
!generated/lucent_api/lib/api/**
generated/lucent_api/lib/api/**/*.g.dart
generated/lucent_api/pubspec.lock

# Drift web worker — compiled from web/drift_worker.dart
web/drift_worker.js
web/drift_worker.js.deps
web/drift_worker.js.map
web/sqlite3.wasm

# Patrol — generated test entrypoint (DO NOT COMMIT)
/patrol_test/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

