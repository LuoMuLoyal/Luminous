################################################################################
#  Luminous — full-stack E2E（Android 模拟器 + 本地 Lucent test runtime）
################################################################################
#  用法：cp .env.e2e.example .env.e2e
#  本文件入库；.env.e2e 不入库。
#
#  为什么单独一份：`--dart-define-from-file` 一次只接受**一个**文件，所以 E2E lane
#  用的这份必须自包含 —— 既给 E2E_* 账号，也给 app 自身的 LUCENT_BASE_URL。
#  scripts/workflows/fullstack.dart 默认优先取 .env.e2e（兼容旧的
#  .env.fullstack-e2e 文件名）。app 日常开发的 .env 与它互不影响。
#
#  ⚠️ 地址不能是 127.0.0.1 / localhost：模拟器里的回环指向模拟器自己。
#     FullstackE2eConfig.assertUsable() 会直接让用例失败。
################################################################################


################################################################################
#  01 · 被测后端
################################################################################

# E2E lane 直连的 Lucent 地址。Android 模拟器访问宿主机固定走 10.0.2.2。
E2E_LUCENT_BASE_URL=http://10.0.2.2:3000

# app 自身的后端地址。E2E 文件顶替 .env 后这一条不再从 .env 来，故这里补一份
# （同一个本地 test runtime）。
LUCENT_BASE_URL=http://10.0.2.2:3000


################################################################################
#  02 · 测试账号（Lucent test runtime 的种子账号）
################################################################################

# 用例登录用的测试账号邮箱。
E2E_TEST_EMAIL=YOUR_TEST_EMAIL@example.com

# 该账号的密码。
E2E_TEST_PASSWORD=YOUR_TEST_PASSWORD

# 用例锚定的记录日期（固定值，避免用例依赖"今天"）。
E2E_RECORD_DATE=2026-06-12

# 断言中使用的昵称。
E2E_TEST_NICKNAME=E2E Record Lane
