# 复制此文件为 .env 并填入实际值

# App 运行时 Lucent 后端地址（Web/桌面本地开发可直接用 127.0.0.1）
LUCENT_BASE_URL=http://127.0.0.1:3000

# 微信移动端 SDK（仅移动端微信登录需要）
WECHAT_MOBILE_APP_ID=
WECHAT_IOS_UNIVERSAL_LINK=

# Full-stack E2E（Android 模拟器优先使用 10.0.2.2，不要复用上面的 localhost）
E2E_LUCENT_BASE_URL=http://10.0.2.2:3000
E2E_TEST_EMAIL=YOUR_TEST_EMAIL@example.com
E2E_TEST_PASSWORD=YOUR_TEST_PASSWORD
E2E_RECORD_DATE=2026-06-12
E2E_TEST_NICKNAME=E2E Record Lane
