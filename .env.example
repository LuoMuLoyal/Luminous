################################################################################
#  Luminous — app 本地开发
################################################################################
#  用法：cp .env.example .env
#  本文件入库；.env 不入库（.gitignore 忽略 .env / .env.*，只放行 *.example）。
#
#  全部变量以活行给出，值即代码内默认值 —— 照抄不会改变任何行为。
#  每个变量上方的注释说明：它是什么、控制什么、什么时候该改。
#
#  ⚠️ 这是**编译期**输入（flutter run --dart-define-from-file=.env）：改完必须
#     重新编译，hot restart 不会重读。VS Code 的 "Luminous" 启动配置已带上本文件。
#
#  不承载 E2E 账号：full-stack E2E 用另一份自包含的 .env.e2e（见
#  .env.e2e.example）。
################################################################################


################################################################################
#  01 · 后端地址
################################################################################

# App 运行时 Lucent 后端地址。Web/桌面本地开发用 127.0.0.1；Android 模拟器用
# 10.0.2.2（模拟器里的 127.0.0.1 指向它自己）；真机填手机能访问到的地址。
# ⚠️ release 构建必须提供：缺了会抛 StateError，而不是发出一个连不上后端的包。
LUCENT_BASE_URL=http://127.0.0.1:3000

# 开发者选项「生产」预设用的地址。本仓库是公开的，线上主机地址不入库：真值写在
# 本文件（不入库）或 CI secret 里。留空时该预设退回 LUCENT_BASE_URL。
LUCENT_PROD_BASE_URL=


################################################################################
#  02 · 微信 SDK（仅移动端微信登录需要）
################################################################################

# 微信开放平台移动应用 AppID。留空则微信登录不可用。
WECHAT_MOBILE_APP_ID=

# iOS Universal Link。仅 iOS 需要，且必须与 Apple 开发者后台的 Associated
# Domains 配置一致，否则回调打不开 App。
WECHAT_IOS_UNIVERSAL_LINK=


################################################################################
#  03 · 推送（JPush）
################################################################################

# JPush AppKey。Dart 侧读它决定推送是否启用；Android 原生侧还需要给 Gradle 传
# -PJPUSH_APP_KEY 或同名环境变量（android/app/build.gradle.kts 经 manifest
# placeholder 填 JPUSH_APPKEY / JPUSH_CHANNEL）。
# 留空则推送整条链路静默禁用。真实 AppKey 不入库。
JPUSH_APP_KEY=


################################################################################
#  04 · 可观测与支持
################################################################################

# Sentry DSN。留空则跳过 Sentry 初始化（debug 直接跳过，release 只告警）。
SENTRY_DSN=

# 帮助页「意见反馈」的 mailto 收件地址。留空则反馈按钮不可用。
SUPPORT_EMAIL=support@luminous.app


################################################################################
#  05 · 实验性 AI 运行时（app 侧 seam，默认全部关闭）
################################################################################

# 是否启用 lib/core/ai/ 这条实验性运行时 seam。默认 false。
# 背景见 docs/explanation/ai-development-workflow.md。
LUMINOUS_EXPERIMENTAL_AI_RUNTIME=false

# 运行时实现选择。取值：ai_toolkit / gen_ui / custom；其它值（含 CI 变量默认的
# openai）一律解析为 none，即不启用本地运行时。
LUMINOUS_AI_RUNTIME_PROVIDER=none

# 是否启用 GenUI 渲染路径（配合 LUMINOUS_AI_RUNTIME_PROVIDER=gen_ui）。默认 false。
LUMINOUS_ENABLE_GEN_UI=false
